<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Test Suite" verbose="1" parallel="tests" thread-count="4" >
    <listeners>
        <listener class-name="framework.listeners.TestListener" />
        <listener class-name="dev.reportinglabs.testng.ReportingLabsListener"/>
    </listeners>


    <test name="Chrome Login">
        <parameter name="Browser" value="chrome"/>
        <classes>
            <class name="tests.securebank.SecureBankLoginTest"/>
            <class name="tests.securebank.SecureBankDashboardTest"/>
        </classes>
    </test>

    <test name="Firefox Login">
        <parameter name="Browser" value="firefox"/>
        <classes>
            <class name="tests.securebank.SecureBankLoginTest"/>
            <class name="tests.securebank.SecureBankDashboardTest"/>
        </classes>
    </test>

    <test name="WebKit Login">
        <parameter name="Browser" value="webkit"/>
        <classes>
            <class name="tests.securebank.SecureBankLoginTest"/>
            <class name="tests.securebank.SecureBankDashboardTest"/>
        </classes>
    </test>

    <test name="Edge Login">
        <parameter name="Browser" value="msedge"/>
        <classes>
            <class name="tests.securebank.SecureBankLoginTest"/>
            <class name="tests.securebank.SecureBankDashboardTest"/>
        </classes>
    </test>

</suite>
