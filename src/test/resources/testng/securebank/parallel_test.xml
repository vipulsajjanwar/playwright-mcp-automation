<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test_Suite" verbose="1" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="framework.listeners.TestListener" />

    </listeners>

    <parameter name="ExecutionID" value="exe_001" />

    <test name="Login Test">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="tests.securebank.SecureBankLoginTest">
                <methods>
                    <include name="verifyDashboardLoad" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="tests.securebank.SecureBankDashboardTest">
                <methods>
                    <include name="verifyDashboardTotalBalanceDisplay" />
                    <include name="verifyRecentTransactionWidget" />

                </methods>
            </class>
        </classes>
    </test>
</suite>
