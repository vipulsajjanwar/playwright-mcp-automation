<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test_Suite" verbose="1">
    <listeners>
        <listener class-name="framework.listeners.TestListener" />
        <listener class-name="framework.listeners.SuiteListener" />
        <listener class-name="framework.listeners.AnnotationTransformer" />
        <listener class-name="framework.listeners.AllureTestListener"/>
        <listener class-name="framework.listeners.ChainTestListener"/>

    </listeners>

    <parameter name="ExecutionID" value="icedq001" />

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
    
        <classes>
            <class name="tests.icedq.admin.LoginTest">
                <methods>
                    <include name="testLoginPageNavigation" />
                    
                </methods>
            </class>
        </classes>
    </test>
</suite>
