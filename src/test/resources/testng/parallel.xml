<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Playwright Test Suite" parallel="methods" thread-count="4" verbose="1">
    <listeners>
        <listener class-name="framework.listeners.TestListener" />
        <listener class-name="framework.listeners.SuiteListener" />
        <listener class-name="framework.listeners.AnnotationTransformer" />
    </listeners>

    <test name="Parallel UI &amp; API Methods Execution">
        <classes>
            <class name="tests.icedq.admin.LoginTest" />
            <class name="tests.ui.UserCreationTest" />
            <class name="tests.ui.DropdownTest" />
            <class name="tests.ui.TableTest" />
            <class name="tests.api.GetUserTest" />
            <class name="tests.api.CreateUserTest" />
        </classes>
    </test>
</suite>
